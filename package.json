{
  "name": "dsh-open-obsidian",
  "version": "0.10.0",
  "description": "DSH 插件：会话在 Obsidian 库里工作时，自动帮你打开那个库——安静地打开，不抢焦点。（是 DSH 插件，不是 Obsidian 插件）",
  "private": false,
  "license": "MIT",
  "author": "NOOBnoob163",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NOOBnoob163/dsh-open-obsidian.git"
  },
  "homepage": "https://github.com/NOOBnoob163/dsh-open-obsidian#readme",
  "bugs": {
    "url": "https://github.com/NOOBnoob163/dsh-open-obsidian/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "obsidian",
    "vault",
    "windows",
    "productivity"
  ],
  "os": [
    "win32"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "bin/",
    "src/",
    "assets/",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
